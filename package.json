{
  "name": "openbox-agent-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "bun run typecheck && bun run format:check && bun test",
    "trace": "bun run scripts/trace.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  }
}
